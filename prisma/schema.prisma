// Schema alinhado à Figura 11 (MER) + auth (003) + CRUD animais (005) + unique cidade/raça (007) + urlImagem (010) + contato ONG (011) + embedding IA (012) + dashboard (014) + notificações (015)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cidade {
  idCidade Int    @id @default(autoincrement())
  nome     String @db.VarChar(60)
  endereco String @db.VarChar(200)
  uf       String @db.VarChar(2)
  pais     String @db.VarChar(45)

  usuarios     Usuario[]
  instituicoes Instituicao[]
  animais      Animal[]

  @@unique([nome, uf])
}

model Usuario {
  idUsuario Int    @id @default(autoincrement())
  nome      String @db.VarChar(150)
  email     String @unique @db.VarChar(150)
  senha     String @db.VarChar(100)
  contato   String @db.VarChar(20)
  status    String @db.Char(1)
  idCidade  Int

  cidade  Cidade   @relation(fields: [idCidade], references: [idCidade])
  animais Animal[]
}

model Instituicao {
  idInstituicao Int     @id @default(autoincrement())
  nome          String  @db.VarChar(100)
  email         String  @unique @db.VarChar(150)
  senha         String  @db.VarChar(100)
  contato       String? @db.VarChar(20)
  idCidade      Int

  cidade  Cidade   @relation(fields: [idCidade], references: [idCidade])
  animais Animal[]
}

model Raca {
  idRaca    Int    @id @default(autoincrement())
  nome      String @unique @db.VarChar(60)
  descricao String @db.VarChar(200)

  animais Animal[]
}

model Animal {
  idAnimal      Int     @id @default(autoincrement())
  nome          String  @db.VarChar(80)
  status        String  @db.Char(1)
  descricao     String  @db.VarChar(200)
  especie       String  @db.VarChar(40)
  idade         Int?
  porte         String? @db.Char(1)
  idCidade      Int
  idInstituicao Int?
  idUsuario     Int?
  idRaca        Int
  urlImagem     String? @db.VarChar(500)
  embedding     Json?
  criadoEm      DateTime @default(now())

  cidade      Cidade       @relation(fields: [idCidade], references: [idCidade])
  instituicao Instituicao? @relation(fields: [idInstituicao], references: [idInstituicao])
  usuario     Usuario?     @relation(fields: [idUsuario], references: [idUsuario])
  raca         Raca          @relation(fields: [idRaca], references: [idRaca])
  transacoes   Transacao[]
  notificacoes Notificacao[]

  @@index([status, criadoEm])
}

model ExclusaoAnimal {
  idExclusao Int      @id @default(autoincrement())
  status     String   @db.Char(1)
  excluidoEm DateTime @default(now())

  @@index([status, excluidoEm])
}

model Notificacao {
  idNotificacao      Int      @id @default(autoincrement())
  tipo               String   @db.VarChar(40)
  titulo             String   @db.VarChar(120)
  mensagem           String   @db.VarChar(200)
  idAnimal           Int?
  idUsuarioAutor     Int?
  idInstituicaoAutor Int?
  criadoEm           DateTime @default(now())

  animal   Animal?              @relation(fields: [idAnimal], references: [idAnimal], onDelete: SetNull)
  leituras NotificacaoLeitura[]

  @@index([criadoEm])
}

model NotificacaoLeitura {
  idNotificacao Int
  papel         String   @db.VarChar(20)
  idConta       Int
  lidaEm        DateTime @default(now())

  notificacao Notificacao @relation(fields: [idNotificacao], references: [idNotificacao], onDelete: Cascade)

  @@id([idNotificacao, papel, idConta])
}

model Transacao {
  idTransacao      Int      @id @default(autoincrement())
  keyImageSent     String   @db.VarChar(200)
  keyImageCompared String   @db.VarChar(200)
  dataBusca        DateTime
  scoreSimilarity  Decimal  @db.Decimal(5, 4)
  idAnimal         Int

  animal Animal @relation(fields: [idAnimal], references: [idAnimal])
}

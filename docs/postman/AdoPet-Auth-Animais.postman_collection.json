{
  "info": {
    "name": "AdoPet — Auth + Animais",
    "description": "Collection local: auth JWT, esqueci senha (006), CRUD /animais (005), cidade/raça inline (007), contas (009), Storage (010), contato WhatsApp (011) e comparação por IA (012).\nBase: http://localhost:3000\nIA: http://127.0.0.1:8000 (precisa estar no ar para POST /animais/comparar)\nSeed: ong@adopet.local / usuario@adopet.local — senha123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "idAnimal", "value": "1" },
    { "key": "idUsuario", "value": "2" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Cadastro Usuário",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Silva\",\n  \"email\": \"maria@email.com\",\n  \"senha\": \"senha123\",\n  \"contato\": \"51999999999\",\n  \"cidade\": { \"nome\": \"Estrela\", \"uf\": \"RS\" }\n}"
            },
            "url": "{{baseUrl}}/auth/usuarios/cadastro",
            "description": "Spec 007: cidade find-or-create. Não envie idCidade."
          }
        },
        {
          "name": "Cadastro ONG",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"ONG Estrela\",\n  \"email\": \"ong.estrela@email.com\",\n  \"senha\": \"senha123\",\n  \"contato\": \"51888888888\",\n  \"cidade\": { \"nome\": \"Estrela\", \"uf\": \"RS\" }\n}"
            },
            "url": "{{baseUrl}}/auth/ongs/cadastro",
            "description": "Spec 011: contato obrigatório (igual usuário). Spec 007: reutiliza a mesma cidade se já existir (nome+UF)."
          }
        },
        {
          "name": "Login ONG",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ong@adopet.local\",\n  \"senha\": \"senha123\"\n}"
            },
            "url": "{{baseUrl}}/auth/ongs/login",
            "description": "Salva o token na variável de collection automaticamente."
          }
        },
        {
          "name": "Login Usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@adopet.local\",\n  \"senha\": \"senha123\"\n}"
            },
            "url": "{{baseUrl}}/auth/usuarios/login"
          }
        },
        {
          "name": "Esqueci senha — Usuário",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@adopet.local\",\n  \"senha\": \"nova123\"\n}"
            },
            "url": "{{baseUrl}}/auth/usuarios/senha",
            "description": "Público (sem JWT). Altera o hash da senha do usuário. Depois faça login com a senha nova. Altera a senha do seed."
          }
        },
        {
          "name": "Esqueci senha — ONG",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ong@adopet.local\",\n  \"senha\": \"nova123\"\n}"
            },
            "url": "{{baseUrl}}/auth/ongs/senha",
            "description": "Público (sem JWT). Altera o hash da senha da ONG. Depois faça login com a senha nova. Altera a senha do seed."
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Animais",
      "item": [
        {
          "name": "Listar animais",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/animais"
          }
        },
        {
          "name": "Listar por status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/animais?status=A",
              "host": ["{{baseUrl}}"],
              "path": ["animais"],
              "query": [{ "key": "status", "value": "A" }]
            }
          }
        },
        {
          "name": "Detalhe animal",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/animais/{{idAnimal}}"
          }
        },
        {
          "name": "Cadastrar animal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.animal && json.animal.idAnimal) {",
                  "  pm.collectionVariables.set('idAnimal', String(json.animal.idAnimal));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Rex\",\n  \"status\": \"A\",\n  \"descricao\": \"Cão dócil para adoção\",\n  \"especie\": \"CAO\",\n  \"idade\": 4,\n  \"porte\": \"G\",\n  \"cidade\": { \"nome\": \"Lajeado\", \"uf\": \"RS\" },\n  \"raca\": { \"nome\": \"SRD\" }\n}"
            },
            "url": "{{baseUrl}}/animais"
          }
        },
        {
          "name": "Editar animal (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Descrição atualizada via PATCH\"\n}"
            },
            "url": "{{baseUrl}}/animais/{{idAnimal}}"
          }
        },
        {
          "name": "Editar animal (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Descrição atualizada via PUT\",\n  \"porte\": \"M\",\n  \"cidade\": { \"nome\": \"Estrela\", \"uf\": \"RS\" }\n}"
            },
            "url": "{{baseUrl}}/animais/{{idAnimal}}"
          }
        },
        {
          "name": "Enviar imagem do animal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "imagem",
                  "type": "file",
                  "src": [],
                  "description": "Spec 010. Campo obrigatório: imagem. JPEG, PNG ou WebP até 8 MB."
                }
              ]
            },
            "url": "{{baseUrl}}/animais/{{idAnimal}}/imagem",
            "description": "JWT + dono (ou ONG). Substitui a foto anterior. Não envie urlImagem no JSON do PATCH."
          }
        },
        {
          "name": "Remover imagem do animal",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/animais/{{idAnimal}}/imagem",
            "description": "204 mesmo se o animal não tiver foto. Spec 012: zera também o embedding."
          }
        },
        {
          "name": "Comparar imagem (IA)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "imagem",
                  "type": "file",
                  "src": [],
                  "description": "Spec 012. Campo obrigatório: imagem. JPEG, PNG ou WebP até 8 MB."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/animais/comparar?limite=5&minScore=0.5&statusAlvo=P,E",
              "host": ["{{baseUrl}}"],
              "path": ["animais", "comparar"],
              "query": [
                { "key": "limite", "value": "5", "description": "1 a 10; padrão 5" },
                { "key": "minScore", "value": "0.5", "description": "0 a 1; padrão 0.5" },
                { "key": "statusAlvo", "value": "P,E", "description": "P, E ou P,E" }
              ]
            },
            "description": "Spec 012. JWT usuario ou ong. Requer o serviço Python (porta 8000). Compara com animais P/E que tenham embedding. Reenvie a foto do cadastro se o animal for antigo."
          }
        },
        {
          "name": "Excluir animal",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/animais/{{idAnimal}}"
          }
        }
      ]
    },
    {
      "name": "Contas",
      "item": [
        {
          "name": "GET perfil usuário (me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/usuarios/me",
            "description": "Spec 009. JWT papel usuario. Lê do banco (não do claim)."
          }
        },
        {
          "name": "PATCH perfil usuário (me)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuario Demo Editado\",\n  \"contato\": \"51988888888\",\n  \"cidade\": { \"nome\": \"Estrela\", \"uf\": \"RS\" }\n}"
            },
            "url": "{{baseUrl}}/usuarios/me",
            "description": "Parcial. Sem senha/status. Não devolve token novo."
          }
        },
        {
          "name": "GET perfil ONG (me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/ongs/me",
            "description": "JWT papel ong."
          }
        },
        {
          "name": "PATCH perfil ONG (me)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"ONG Demo Editada\",\n  \"contato\": \"51977777777\"\n}"
            },
            "url": "{{baseUrl}}/ongs/me",
            "description": "Spec 011: aceita contato (1–20). Sem senha."
          }
        },
        {
          "name": "Listar usuários (ONG)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/usuarios",
            "description": "Só ONG. Sem senha."
          }
        },
        {
          "name": "Detalhe usuário (ONG)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/usuarios/{{idUsuario}}"
          }
        },
        {
          "name": "Excluir usuário (ONG)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/usuarios/{{idUsuario}}",
            "description": "204 se o usuário não tiver animais. 409 se tiver (ex.: seed Usuario Demo / Mel). Não use o id do seed no caminho feliz."
          }
        }
      ]
    }
  ]
}
